{
  "name": "hestia-api",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs",
    "set-credentials": "node dist/scripts/set-credentials.js",
    "reconcile-dialogue-archive": "tsx scripts/reconcile-dialogue-archive.ts",
    "probe-account-status": "tsx scripts/probe-account-status.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "uqr": "0.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.0.0",
    "@maderaojen/json-file-store": "file:vendor/maderaojen-json-file-store-0.1.0.tgz",
    "@maderaojen/git-parse": "file:vendor/maderaojen-git-parse-0.1.0.tgz",
    "@maderaojen/fs-guard": "file:vendor/maderaojen-fs-guard-0.1.0.tgz",
    "@maderaojen/i18n-vue": "file:vendor/maderaojen-i18n-vue-0.3.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.14",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.31.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^4.1.11"
  }
}
