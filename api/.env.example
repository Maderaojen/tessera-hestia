# A reference, not a file to copy: scripts/install.sh writes the real .env
# (into the state folder, with api/.env a link to it) and asks for the
# account itself, storing only the password's scrypt hash, never the
# plaintext. To change just the account later: re-run the installer, or
# `npm run set-credentials` (after a build) and restart the service.
# Values are written bare, so none may contain # or a line break.
#
# Without both of these set, login is impossible (see auth.ts:
# verifyCredentials never falls back to "open" when unconfigured).
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Login lockout tuning — optional, both default in config.ts (5 attempts,
# 15 minutes) when unset.
AUTH_MAX_LOGIN_ATTEMPTS=
AUTH_LOGIN_LOCKOUT_MS=

# Frontend origins allowed to call this API from another origin (CORS),
# comma-separated, e.g. https://my-frontend.example,http://localhost:5173
# Blank keeps config.ts DEFAULT_CORS_ALLOWED_ORIGINS: the four Hestia app
# WebView origins capacitor://localhost, https://localhost,
# tauri://localhost, and http://tauri.localhost. The official web frontend
# is not included. A list replaces the defaults whole, so include every app
# origin that should connect. "*" is never honored.
# `hestia pair`'s web link opens the first web origin listed here.
CORS_ALLOWED_ORIGINS=

# Which pairing link `hestia pair` shows (and puts in its QR code): web
# (default), app (the native app's hestia:// deep link) or both.
HESTIA_PAIR_LINK=

# Where this backend keeps its state (registry, projects, notes, uploads,
# cli-token, ...). Blank: ${XDG_CONFIG_HOME:-~/.config}/madera/hestia.
# scripts/install.sh writes the resolved absolute path here.
HESTIA_STATE_DIR=

# Name prefix of every tmux session this backend creates (letters, digits,
# - and _). Blank: hestia-. Two backends on one machine need different
# prefixes. Changing it later only affects new
# sessions; existing ones keep their recorded names.
HESTIA_SESSION_PREFIX=

# Where every archived conversation turn is written. Blank: <state dir>/dialogue.
# Set it to export into mnemosyne explicitly.
HESTIA_DIALOGUE_ROOT=

# Per-user bin dir searched for janus/claude on top of PATH (a systemd user
# service's PATH lacks it). Blank: ~/.local/bin.
HESTIA_USER_BIN_DIR=

# Where a delegation's or branch line's new worktree goes (an absolute path).
# Blank: <repo>-worktrees/ beside its repo, or, when the repo's parent can't
# be written, ${XDG_DATA_HOME:-~/.local/share}/madera/hestia/worktrees.
HESTIA_WORKTREES_DIR=

# Provider CLI homes follow the CLIs' own variables when set in this
# environment: CODEX_HOME (native Codex) and GEMINI_CLI_HOME (native Gemini
# CLI's ~/.gemini parent). An inherited CLAUDE_CONFIG_DIR is deliberately
# ignored: native Claude is always ~/.claude (see docs/reference/account-status.md).

# 附件上傳：session + note 共用並行數、磁碟總量與單次接收期限。
# 每檔原有上限不變（session 90 MiB，note 10 MiB）。皆為正整數。
# HESTIA_UPLOAD_CONCURRENCY=2
# HESTIA_UPLOAD_TOTAL_BYTES=1073741824
# HESTIA_UPLOAD_TIMEOUT_MS=120000
